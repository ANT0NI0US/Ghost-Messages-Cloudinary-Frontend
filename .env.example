# Production: the full URL of the deployed backend (no trailing slash), e.g. https://ghost-messages-api.onrender.com
# Leave it empty in development: requests go to /api and Vite proxies them to DEV_BACKEND_URL
VITE_API_URL=

# Optional: Google OAuth web client id (must also be listed in the backend WEB_CLIENT_IDS). Leave empty to hide the Google button
VITE_GOOGLE_CLIENT_ID=

# Development only (used by vite.config.js, never shipped to the browser)
DEV_BACKEND_URL=http://localhost:4000
DEV_FORWARDED_IP=41.33.0.1
